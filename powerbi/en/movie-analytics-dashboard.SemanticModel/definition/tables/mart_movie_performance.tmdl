		lineageTag: a294734c-d88e-4a92-b8b9-00f432e794c4
		summarizeBy: none
		sourceColumn: budget_range_order

	partition mart_movie_performance = m
		mode: import
		source =
				let
				    Origen = Databricks.Catalogs("<databricks-server-hostname>", "<sql-warehouse-http-path>", [Catalog = "", Database = ""]),
				    databricks_ws_Database = Origen{[Name="databricks_ws",Kind="Database"]}[Data],
				    gold_Schema = databricks_ws_Database{[Name="gold",Kind="Schema"]}[Data],
				    mart_movie_performance_View = gold_Schema{[Name="mart_movie_performance",Kind="View"]}[Data],
				    Tipos = Table.TransformColumnTypes(mart_movie_performance_View, {{"budget_range", type text}, {"decade", Int64.Type}}),
				    Rangos = Table.TransformColumns(Tipos, {{"budget_range", each let Tier = if _ = null then "" else Text.Trim(_) in if Tier = "Bajo" then "Low" else if Tier = "Medio" then "Medium" else if Tier = "Alto" then "High" else if Tier = "Muy alto" then "Very high" else if Tier = "" or Tier = "Sin datos" then "No data" else Tier, type text}}),
				    OrdenPresupuesto = Table.AddColumn(Rangos, "budget_range_order", each
				        if [budget_range] = "Low" then 1
				        else if [budget_range] = "Medium" then 2
				        else if [budget_range] = "High" then 3
				        else if [budget_range] = "Very high" then 4
				        else 5, Int64.Type)
				in
				    OrdenPresupuesto

	annotation PBI_ResultType = Table
