table mart_movie_performance
	lineageTag: f5799c15-f296-4519-aa53-6c61aa23f059

	measure 'Películas (películas)' = DISTINCTCOUNTNOBLANK('mart_movie_performance'[movie_id])
		formatString: #,0
		lineageTag: 8f5860dc-7c88-441c-8fb4-c40d8d35cb63

	/// Películas distintas con un indicador de éxito informado.
	measure 'Películas válidas (películas)' = CALCULATE([Películas (películas)], KEEPFILTERS(NOT ISBLANK('mart_movie_performance'[reached_2x])))
		formatString: #,0
		lineageTag: 8d351d3e-5e32-4f6e-a45c-7446be8d68a5

	/// Películas que alcanzaron 2x sobre películas con datos financieros válidos.
	measure 'Tasa de éxito 2x (películas)' = DIVIDE(COALESCE(CALCULATE([Películas (películas)], KEEPFILTERS('mart_movie_performance'[reached_2x] == 1)), 0), [Películas válidas (películas)])
		formatString: 0.0%
		lineageTag: 4543f04f-7f95-44a1-be5e-3268b31f185c

	/// Mediana del múltiplo calculado en Databricks, con una observación por película.
	measure 'Múltiplo mediano (películas)' =
			VAR PeliculasConMultiplo =
			    CALCULATETABLE(
			        VALUES('mart_movie_performance'[movie_id]),
			        KEEPFILTERS(NOT ISBLANK('mart_movie_performance'[movie_id])),
			        KEEPFILTERS(NOT ISBLANK('mart_movie_performance'[revenue_multiple]))
			    )
			RETURN
			    MEDIANX(PeliculasConMultiplo, CALCULATE(MAX('mart_movie_performance'[revenue_multiple])))
		formatString: 0.00"x"
		lineageTag: be116cc0-9a81-43eb-8f88-f0b74e8c59a1

	measure Título = SELECTEDVALUE('mart_movie_performance'[title])
		lineageTag: 7e1353fe-c96c-491c-9ee5-8d278cd05f3f

	measure Presupuesto = SELECTEDVALUE('mart_movie_performance'[budget])
		formatString: "$" #,0
		lineageTag: cb036a38-b716-4fea-9967-1ed40657aba1

	measure 'Recaudación bruta' = SELECTEDVALUE('mart_movie_performance'[revenue])
		formatString: "$" #,0
		lineageTag: f53cef32-e1d3-407d-b4d9-d1e01eec56bd

	measure 'Múltiplo individual' = SELECTEDVALUE('mart_movie_performance'[revenue_multiple])
		formatString: 0.0"x"
		lineageTag: 0a5c6465-9b25-4bf5-81e5-78513383ca93

	measure 'Orden del rango' =
			SWITCH(
			    SELECTEDVALUE('mart_movie_performance'[budget_range]),
			    "Bajo", 1, "Low", 1,
			    "Medio", 2, "Medium", 2,
			    "Alto", 3, "High", 3,
			    "Muy alto", 4, "Very high", 4,
			    5
			)
		formatString: 0
		isHidden
		lineageTag: 8a924da8-2375-43f7-8185-bd425418ae0c

	/// Tasa de éxito para décadas con al menos 20 películas financieras válidas.
	measure 'Éxito 2x por década' = IF([Películas válidas (películas)] >= 20, [Tasa de éxito 2x (películas)])
		formatString: 0.0%
		lineageTag: 788a9973-e98e-438a-919e-9cf998003798

