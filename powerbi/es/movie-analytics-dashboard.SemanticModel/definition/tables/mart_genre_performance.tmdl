		sourceColumn: budget_range_order

	partition mart_genre_performance = m
		mode: import
		source =
				let
				    Origen = Databricks.Catalogs("<databricks-server-hostname>", "<sql-warehouse-http-path>", [Catalog = "", Database = ""]),
				    databricks_ws_Database = Origen{[Name="databricks_ws",Kind="Database"]}[Data],
				    gold_Schema = databricks_ws_Database{[Name="gold",Kind="Schema"]}[Data],
				    mart_genre_performance_View = gold_Schema{[Name="mart_genre_performance",Kind="View"]}[Data],
				    Tipos = Table.TransformColumnTypes(mart_genre_performance_View, {{"budget_range", type text}}),
				    Rangos = Table.TransformColumns(Tipos, {{"budget_range", each if _ = null or Text.Trim(_) = "" then "Sin datos" else Text.Trim(_), type text}}),
				    OrdenPresupuesto = Table.AddColumn(Rangos, "budget_range_order", each
				        if [budget_range] = "Bajo" then 1
				        else if [budget_range] = "Medio" then 2
				        else if [budget_range] = "Alto" then 3
				        else if [budget_range] = "Muy alto" then 4
				        else 5, Int64.Type)
				in
				    OrdenPresupuesto
