table mart_genre_performance
	lineageTag: 979f064d-b4c0-4d31-ae69-1ad8528de18f

	measure 'Películas (géneros)' = DISTINCTCOUNTNOBLANK('mart_genre_performance'[movie_id])
		formatString: #,0
		lineageTag: bb5ad9bb-b3e6-408c-b824-fe1cd38c7769

	/// Películas distintas con un indicador de éxito informado.
	measure 'Películas válidas (géneros)' = CALCULATE([Películas (géneros)], KEEPFILTERS(NOT ISBLANK('mart_genre_performance'[reached_2x])))
		formatString: #,0
		lineageTag: 20a20d3a-f640-4a0c-9492-dc1a5f1f5609

	/// Películas que alcanzaron 2x sobre películas con datos financieros válidos.
	measure 'Tasa de éxito 2x (géneros)' = DIVIDE(COALESCE(CALCULATE([Películas (géneros)], KEEPFILTERS('mart_genre_performance'[reached_2x] == 1)), 0), [Películas válidas (géneros)])
		formatString: 0.0%
		lineageTag: b6adb82b-d1c5-4a51-9f8a-ffe1e52ead69

	/// Mediana del múltiplo calculado en Databricks, con una observación por película.
	measure 'Múltiplo mediano (géneros)' =
			VAR PeliculasConMultiplo =
			    CALCULATETABLE(
			        VALUES('mart_genre_performance'[movie_id]),
			        KEEPFILTERS(NOT ISBLANK('mart_genre_performance'[movie_id])),
			        KEEPFILTERS(NOT ISBLANK('mart_genre_performance'[revenue_multiple]))
			    )
			RETURN
			    MEDIANX(PeliculasConMultiplo, CALCULATE(MAX('mart_genre_performance'[revenue_multiple])))
		formatString: 0.0"x"
		lineageTag: 059c1ce5-b0eb-40c5-a851-ad89c35d779a

	/// Muestra la tasa cuando la celda tiene al menos 20 películas válidas.
	measure 'Tasa 2x de la muestra' = IF([Películas válidas (géneros)] >= 20, [Tasa de éxito 2x (géneros)])
		formatString: 0.0%
		lineageTag: 4dc355eb-a879-4c83-9bda-9f927f10c9b8

	measure 'Color de tasa 2x' =
			VAR Tasa = [Tasa 2x de la muestra]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(Tasa), "#F1F5F9",
			        Tasa < 0.25, "#F0F9F8",
			        Tasa < 0.50, "#D5EFEB",
			        Tasa < 0.75, "#A9DFD7",
			        "#79C9BD"
			    )
		isHidden
		lineageTag: 155d4e5c-df65-449a-8fbd-03ecef05b3e8

