table mart_company_performance
	lineageTag: e8a8a1d7-3194-4423-8783-9412a7504ae9

	measure 'Películas (productoras)' = DISTINCTCOUNTNOBLANK('mart_company_performance'[movie_id])
		formatString: #,0
		lineageTag: 4b2f6a12-1c2d-4bee-a2da-ee2328f4412c

	/// Películas distintas con un indicador de éxito informado.
	measure 'Películas válidas (productoras)' = CALCULATE([Películas (productoras)], KEEPFILTERS(NOT ISBLANK('mart_company_performance'[reached_2x])))
		formatString: #,0
		lineageTag: 7d188d00-c1fb-414e-8a3d-2dad883e8c06

	/// Películas que alcanzaron 2x sobre películas con datos financieros válidos.
	measure 'Tasa de éxito 2x (productoras)' = DIVIDE(COALESCE(CALCULATE([Películas (productoras)], KEEPFILTERS('mart_company_performance'[reached_2x] == 1)), 0), [Películas válidas (productoras)])
		formatString: 0.0%
		lineageTag: 2e733e47-6da4-43f6-b12f-3d70a070274e

	/// Mediana del múltiplo calculado en Databricks, con una observación por película.
	measure 'Múltiplo mediano (productoras)' =
			VAR PeliculasConMultiplo =
			    CALCULATETABLE(
			        VALUES('mart_company_performance'[movie_id]),
			        KEEPFILTERS(NOT ISBLANK('mart_company_performance'[movie_id])),
			        KEEPFILTERS(NOT ISBLANK('mart_company_performance'[revenue_multiple]))
			    )
			RETURN
			    MEDIANX(PeliculasConMultiplo, CALCULATE(MAX('mart_company_performance'[revenue_multiple])))
		formatString: 0.0"x"
		lineageTag: 6899e823-f954-4595-b1c0-d3361aff0749

	/// Orden por tasa descendente y nombre ascendente para desempatar.
	measure 'Posición entre productoras' =
			VAR NombreActual = SELECTEDVALUE('mart_company_performance'[company_name])
			VAR TasaActual = [Tasa de éxito 2x (productoras)]
			VAR Elegibles =
			    FILTER(
			        ADDCOLUMNS(
			            ALLSELECTED('mart_company_performance'[company_name]),
			            "@Validas", [Películas válidas (productoras)],
			            "@Tasa", [Tasa de éxito 2x (productoras)]
			        ),
			        NOT ISBLANK('mart_company_performance'[company_name]) && [@Validas] >= 20
			    )
			RETURN
			    IF(
			        NOT ISBLANK(NombreActual) && [Películas válidas (productoras)] >= 20,
			        1 + COUNTROWS(
			            FILTER(
			                Elegibles,
			                [@Tasa] > TasaActual
			                    || ([@Tasa] = TasaActual && 'mart_company_performance'[company_name] < NombreActual)
			            )
			        ),
			        11
			    )
		formatString: 0
		lineageTag: 9ae36a72-129c-41a3-9e87-287ebeffa514

